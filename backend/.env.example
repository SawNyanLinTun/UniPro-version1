# Supabase Postgres (Settings → Database → URI). Use postgresql+psycopg2:// ...
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase JWT Secret (Settings → API) — used to verify access tokens
JWT_SECRET=your-supabase-jwt-secret
JWT_AUDIENCE=authenticated

CORS_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=false

# Optional
# GEMINI_API_KEY=   # required for CV analyze embeddings (text-embedding-004) + skill extract
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=

# Internship certificates — Ed25519 private key (base64, 32 bytes). KEEP SECRET.
# Generate: python -m app.signing
CERTIFICATE_SIGNING_KEY=
CERTIFICATE_KEY_ID=unipro-cert-key-1
# Frontend origin used in verify links: <PUBLIC_APP_URL>/#/verify/<id>
PUBLIC_APP_URL=http://localhost:3000
# Set true once company verification is in place
REQUIRE_VERIFIED_COMPANY_FOR_CERTIFICATES=false
